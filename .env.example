# 처음 설정할 때만 .env로 복사하고 값을 입력하세요. 기존 .env는 보존하세요.
# 실제 키와 웹훅 URL은 Git에 커밋하지 마세요.
# GitHub Actions에서는 동일한 이름의 Repository secrets로 설정합니다.

DISCORD_WEBHOOK_URL=
OPENAI_API_KEY=

# 다른 provider를 선택했을 때만 설정합니다.
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# 기존 범용 키 fallback, 선택한 provider에 맞는 키여야 함
# LLM_API_KEY=
